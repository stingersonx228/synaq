# LLM (server only). Without a key the game uses scripted intern lines and a keyword judge.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# 1 = force the scripted (no-LLM) mode, e.g. for an offline stage demo.
LLM_DISABLED=0
# Per-student budget of LLM requests per hour; above it the scripted mode is used.
LLM_CALLS_PER_HOUR=60

# Supabase. Without these the game runs in local mode (results stay in the browser).
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
